# Copy this file to .env for local development. These values are local-only.
POSTGRES_USER=ai_profit_monitor
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=ai_profit_monitor
POSTGRES_PORT=5437
API_PORT=8000
WEB_PORT=3000

APP_ENV=development
APP_NAME=AI Profit Monitor API
DATABASE_URL=postgresql+asyncpg://ai_profit_monitor:local_development_only@localhost:5437/ai_profit_monitor
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Opaque server-side session configuration. Use Secure=true in production.
SESSION_COOKIE_NAME=ai_profit_monitor_session
SESSION_LIFETIME_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=example.com
SESSION_LAST_USED_UPDATE_SECONDS=300
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Module 3 ingestion and event-query bounds.
INGESTION_MAX_BATCH_SIZE=100
INGESTION_MAX_BODY_BYTES=1048576
EVENT_MAX_FUTURE_SECONDS=300
EVENT_MAX_AGE_DAYS=365
EVENT_PAGE_SIZE=25
EVENT_MAX_PAGE_SIZE=100
EVENT_MAX_QUERY_DAYS=366
API_KEY_LAST_USED_UPDATE_SECONDS=300

# Text-token costs select this exact catalog currency; no currency conversion.
COST_CURRENCY=USD

# NEXT_PUBLIC_ values are exposed to the browser; never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

